# Còpia aquest fitxer a .env i posa-hi els valors reals de producció.

# Clau secreta de Django (genera una de llarga i aleatòria, p. ex. `openssl rand -hex 32`)
SECRET_KEY=canvia-aixo-per-una-clau-aleatoria-larga

# Debug apagat en producció
DEBUG=0

# Domini on es servirà l'app (separat per comes)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígens de confiança per a CSRF (amb https:// inclòs); recomanat amb domini propi
#CSRF_TRUSTED_ORIGINS=https://todo.elmeudomini.cat

# Cookies de sessió/CSRF només per HTTPS: posa-ho a 1 en producció amb TLS
COOKIE_SECURE=0

# Credencials de PostgreSQL
POSTGRES_DB=todos
POSTGRES_USER=todos
POSTGRES_PASSWORD=canvia-aixo
